{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "description": "API NestJS (monolito modular hexagonal) de Flight Booking Realtime.",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prebuild": "prisma generate",
    "build": "nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "migrate": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "jest --config jest.config.ts",
    "test:e2e": "prisma generate && node --experimental-vm-modules --no-warnings=ExperimentalWarning ./node_modules/jest/bin/jest.js --config test/jest-e2e.config.ts --runInBand",
    "test:cov": "jest --config jest.config.ts --coverage"
  },
  "dependencies": {
    "@kata/shared": "workspace:*",
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/platform-socket.io": "^11.2.11",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/websockets": "^11.2.11",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.0",
    "helmet": "^8.3.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.6.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.11",
    "@testcontainers/postgresql": "^12.2.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
