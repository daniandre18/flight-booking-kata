# Copia este archivo a .env para desarrollo local (pnpm dev / pnpm seed).
# En docker compose las variables se definen en docker-compose.yml.

# Conexión a PostgreSQL (servicio `db` de docker compose expuesto en localhost:5432).
DATABASE_URL=postgresql://kata:kata@localhost:5432/kata
# Tamaño del pool del adaptador pg de Prisma 7 (la prueba de concurrencia lo necesita).
DB_POOL_MAX=20

# Clave para retrasar o cancelar vuelos (cámbiala fuera de la demo).
ADMIN_KEY=demo-admin-key

# Duración del bloqueo compartido y del barrido de bloqueos vencidos.
HOLD_TTL_SECONDS=600
HOLD_SWEEP_INTERVAL_MS=2000

# Seguridad (principio X): orígenes CORS, tamaño máximo del body y multiplicador de límites.
CORS_ORIGINS=http://localhost:4200,http://localhost:8080
BODY_LIMIT=16kb
RATE_LIMIT_MULTIPLIER=1

PORT=3000
LOG_LEVEL=info
